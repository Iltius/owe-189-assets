+-- Wallpaper Engine stores one copy of every language-dependent property and
+-- gates each copy with a `condition` on the scene's own language selector
+-- (`language.value == 4`). waywallen does not evaluate that field, so a
+-- multi-language scene lists every variant at once: Vietnamese labels next to
+-- Chinese combo options inside a Spanish UI
+-- (waywallen/open-wallpaper-engine#189). Decode the language the host UI is in
+-- and show only that variant, so the panel stays one readable list. A
+-- condition this decoder cannot parse is left visible on purpose: hiding a
+-- property the scene still uses would break the wallpaper.
+local LANGUAGE_CODES = {
+    ["english"] = "en", ["spanish"] = "es", ["espanol"] = "es", ["espanol"] = "es",
+    ["french"] = "fr", ["francais"] = "fr", ["german"] = "de",
+    ["deutsch"] = "de",
+    ["italian"] = "it", ["italiano"] = "it", ["portuguese"] = "pt",
+    ["brazilian"] = "pt-br", ["russian"] = "ru", ["russia"] = "ru",
+    ["vietnamese"] = "vi", ["chinese"] = "zh", ["japanese"] = "ja",
+    ["korean"] = "ko", ["ukrainian"] = "uk", ["polish"] = "pl",
+    ["polski"] = "pl", ["turkish"] = "tr", ["dutch"] = "nl",
+    ["nederlands"] = "nl", ["czech"] = "cs", ["swedish"] = "sv",
+    ["svenska"] = "sv", ["hungarian"] = "hu", ["romanian"] = "ro",
+    ["thai"] = "th", ["indonesian"] = "id", ["arabic"] = "ar",
+}
+
+LANGUAGE_CODES["español"] = "es"
+LANGUAGE_CODES["français"] = "fr"
+LANGUAGE_CODES["русский"] = "ru"
+LANGUAGE_CODES["tiếng việt"] = "vi"
+LANGUAGE_CODES["中文"] = "zh"
+LANGUAGE_CODES["日本語"] = "ja"
+LANGUAGE_CODES["한국어"] = "ko"
+LANGUAGE_CODES["українська"] = "uk"
+LANGUAGE_CODES["čeština"] = "cs"
+LANGUAGE_CODES["türkçe"] = "tr"
+LANGUAGE_CODES["ไทย"] = "th"
+
+local function host_language(ctx)
+    for _, name in ipairs({ "LC_ALL", "LC_MESSAGES", "LANG" }) do
+        local value = ctx.env(name)
+        if value and value ~= "" and value ~= "C" and value ~= "POSIX" then
+            local lang = split_posix_locale(value)
+            if lang then return lang end
+        end
+    end
+    return nil
+end
+
+-- The value of the scene's own language selector that matches the host UI, so
+-- labels, combo options and the rendered wallpaper all agree.
+local function preferred_language(props, ctx)
+    local selector = props["language"]
+    if type(selector) ~= "table" or selector.type ~= "combo" or
+        type(selector.options) ~= "table" then
+        return nil
+    end
+    local lang = host_language(ctx)
+    if not lang then return nil end
+    for _, option in ipairs(selector.options) do
+        local label = string.lower(tostring(option.label or ""))
+        local code = LANGUAGE_CODES[label]
+        if not code then
+            local base = string.match(label, "^([%a%s]+)%s*%(")
+            code = base and LANGUAGE_CODES[base] or nil
+        end
+        if code == lang then return tostring(option.value) end
+    end
+    return nil
+end
+
+local function condition_literal(text)
+    local quoted = string.match(text, '^"(.*)"$') or string.match(text, "^'(.*)'$")
+    if quoted then return quoted end
+    if text == "true" then return true end
+    if text == "false" then return false end
+    return tonumber(text) or text
+end
+
+local function compare_values(left, operator, right)
+    if left == nil then return false end
+    if type(left) ~= type(right) then
+        local left_number, right_number = tonumber(left), tonumber(right)
+        if left_number and right_number then left, right = left_number, right_number end
+    end
+    if operator == "==" then return left == right end
+    if operator == "~=" or operator == "!=" then return left ~= right end
+    local left_number, right_number = tonumber(left), tonumber(right)
+    if not left_number or not right_number then return false end
+    if operator == ">" then return left_number > right_number end
+    if operator == "<" then return left_number < right_number end
+    if operator == ">=" then return left_number >= right_number end
+    return left_number <= right_number
+end
+
+-- True / false / nil, where nil means "cannot decide" and keeps the property
+-- visible. Only a single `<key>.value <op> <literal>` clause is decoded:
+-- Wallpaper Engine's own language gates use exactly that shape.
+local function condition_holds(expression, values)
+    if type(expression) ~= "string" then return nil end
+    local clause = string.gsub(expression, "%s+", " ")
+    clause = string.gsub(clause, "^ ", "")
+    clause = string.gsub(clause, " $", "")
+    if clause == "" then return nil end
+    if string.find(clause, "&&", 1, true) or string.find(clause, "||", 1, true) or
+        string.find(clause, "(", 1, true) then
+        return nil
+    end
+    local name, operator, text = string.match(clause, "^(.-)%.value%s*([=~!<>]+)%s*(.-)$")
+    if not name or name == "" then return nil end
+    if operator ~= "==" and operator ~= "~=" and operator ~= "!=" and
+        operator ~= ">" and operator ~= "<" and operator ~= ">=" and
+        operator ~= "<=" then
+        return nil
+    end
+    return compare_values(values[name], operator, condition_literal(text))
+end
+
+local function apply_conditions(props, ctx)
+    local language = preferred_language(props, ctx)
+    if not language then return props end
+    local values = { language = language }
+    local kept = {}
+    for key, property in pairs(props) do
+        local visible = true
+        local expression = type(property) == "table" and property.condition or nil
+        -- Only the language gate is dropped: waywallen recomputes this list
+        -- from authored defaults, so hiding a property that another condition
+        -- gates on a live panel value would make it unreachable once the user
+        -- flips that value.
+        if type(expression) == "string" and
+            string.find(expression, "language.value", 1, true) and
+            condition_holds(expression, values) == false then
+            visible = false
+        end
+        if visible then kept[key] = property end
+    end
+    if type(kept["language"]) == "table" then
+        kept["language"].value = language
+    end
+    return kept
+end
